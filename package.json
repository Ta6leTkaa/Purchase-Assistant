{
  "name": "purchase-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first family autofill browser extension prototype",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "0.0.287",
    "jsdom": "26.0.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
