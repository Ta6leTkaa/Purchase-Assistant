{
  "name": "purchase-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first family autofill browser extension prototype",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
