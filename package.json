    "demo": "node scripts/serve-demo.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "jsdom": "26.0.0",
    "typescript": "5.7.3"
  },
  "engines": {"node": ">=22"}
}
